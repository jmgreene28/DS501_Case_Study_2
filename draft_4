- How many movies have an average rating over 4.5 overall?

```{r echo=F, eval=T}
#fav movies overall
favMovies <- mlData %>% filter(rating>4.5)

#table of movies with most 4 or 5 rating votes
knitr::kable(head(favMovies %>%
                    group_by(movie_title) %>%
                    summarise(count=n()) %>%
                    arrange(desc(count))))
head(10)
```

##another attempt at highest rated movies, mean rating score
```r{ echo=F, eval=T}
averageRating <- mlData %>%
  group_by(movie_title) %>%
  summarise(avg_rating = mean(rating, na.rm = TRUE)) %>%
  arrange(desc(avg_rating))

knitr::kable(head(averageRating)) %>% head(10)
```

##mean rating score again, but min threshold of votes
```r{echo=F, eval=T}
min_ratings <- 25
filteredavgRating <-  mlData %>%
  group_by(movie_title) %>%
  summarise(
    avg_rating = mean(rating, na.rm = TRUE),
    rating_count = n()
  ) %>%
  filter(rating_count >= min_ratings) %>%
  arrange(desc(avg_rating))

knitr::kable(head(filteredavgRating)) %>% head(10)
``

